@model IEnumerable<Auditor.Models.Airport>
@using Auditor.Models.Lookups

@{
    ViewData["Title"] = "Airports";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canAdd = ViewBag.CanAddAirports as bool? ?? true;
}

<div class="list-container">
    <div class="list-header">
        <div class="list-header-content">
            <h1>✈️ Airports</h1>
            <p class="list-header-subtitle">Manage your airport locations and information</p>
        </div>
        @if (Model.Any() && canAdd)
        {
            <a asp-action="Create" class="btn-list-primary">
                <span>+</span> Create New Airport
            </a>
        }
    </div>

    <partial name="_PageAlerts" />

    @if (Model.Any())
    {
        <div class="list-table-wrapper">
            <table class="list-table table airport-table">
                <thead>
                    <tr>
                        <th style="width: 24%;">Airport</th>
                        <th style="width: 9%;">Code</th>
                        <th style="width: 12%;">Type</th>
                        <th style="width: 17%;">Region / Country</th>
                        <th style="width: 16%;">Areas</th>
                        <th style="width: 8%;">Sites</th>
                        <th style="width: 9%;">Status</th>
                        <th style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="cell-name">@item.Name</div>
                                @if (!string.IsNullOrEmpty(item.AirportManager))
                                {
                                    <small class="text-muted">@item.AirportManager</small>
                                }
                            </td>
                            <td>
                                <span class="cell-code">@item.Code</span>
                            </td>
                            <td>
                                <div class="cell-secondary">@(item.AirportType ?? "—")</div>
                            </td>
                            <td>
                                @{
                                    var place = string.Join(", ", new[] { item.Region, item.Country }.Where(v => !string.IsNullOrEmpty(v)));
                                }
                                <div class="cell-secondary">@(place.Length > 0 ? place : "—")</div>
                            </td>
                            <td>
                                <div class="cell-secondary">
                                    @{
                                        var areaCounts = AirportLookups.AreaTypes
                                            .Select(t => (Label: t.Value, Count: item.Locations.Count(l => l.AreaType == t.Key)))
                                            .Where(t => t.Count > 0)
                                            .ToList();
                                    }
                                    @if (areaCounts.Count == 0)
                                    {
                                        <span class="area-empty">None</span>
                                    }
                                    else
                                    {
                                        @string.Join(" · ", areaCounts.Select(t => $"{t.Count} {t.Label.Replace(" Locations", "")}"))
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="cell-secondary">@item.AuditSites.Count</div>
                            </td>
                            <td>
                                <span class="status-pill @(item.IsActive ? "status-pill-active" : "status-pill-inactive")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div class="list-actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-view">View</a>
                                    @if (canAdd)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete">Delete</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="list-table-wrapper">
            <div class="list-empty-state">
                <div class="empty-state-icon">📭</div>
                <h2 class="empty-state-title">No Airports Yet</h2>
                <p class="empty-state-text">Get started by creating your first airport</p>
                <a asp-action="Create" class="btn-list-primary">
                    <span>+</span> Create First Airport
                </a>
            </div>
        </div>
    }
</div>
