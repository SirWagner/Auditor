@{
    ViewData["Title"] = "Change Password";
}

<div class="form-page-container">
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <span>Change Password</span>
    </div>

    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>Change Password</h1>
            <p>Signed in as @User.Identity?.Name</p>
        </div>
    </div>

    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-content">
                <form action="/account/password" method="post" id="changePasswordForm" novalidate>
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="validation-alert">
                            <h3><i class="fas fa-times-circle"></i> Fix the following before saving</h3>
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="form-section">
                        <div class="form-grid full">
                            <div class="form-group">
                                <label for="currentPassword">Current Password <span class="required">*</span></label>
                                <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required />
                            </div>
                            <div class="form-group">
                                <label for="newPassword">New Password <span class="required">*</span></label>
                                <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" required />
                                <div class="form-group-hint">At least 8 characters, with at least one letter and one number.</div>
                            </div>
                            <div class="form-group">
                                <label for="confirmPassword">Confirm New Password <span class="required">*</span></label>
                                <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required />
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="form-main-footer">
                <a asp-controller="Dashboard" asp-action="Index" class="btn-cancel"><i class="fas fa-times"></i> Cancel</a>
                <button form="changePasswordForm" type="submit" class="btn-submit"><i class="fas fa-key"></i> Change Password</button>
            </div>
        </div>
    </div>
</div>
