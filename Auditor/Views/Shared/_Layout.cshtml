@using Auditor.Security
@{
    var isAdmin = User.IsInRole(Roles.Admin);
    var isManager = isAdmin || User.IsInRole(Roles.Manager);
    var isAuditor = User.IsInRole(Roles.Auditor);
    var displayName = User.Identity?.Name ?? "";
    var initials = string.Concat(displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => char.ToUpperInvariant(p[0])));
    if (string.IsNullOrEmpty(initials)) { initials = "?"; }
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var employeeNumber = User.FindFirst("employee_number")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Auditor</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Auditor.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/azia-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/Azia/css/azia.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Azia/lib/fontawesome-free/css/all.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Azia/lib/ionicons/css/ionicons.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Azia/lib/typicons.font/typicons.css")" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auditor-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auditor-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auditor-details-practical.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auditor-details-related.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/airport-sites.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>

<body>
    <header class="auditor-header-wrapper">
        <div class="az-header">
            <div class="container-fluid">
                <div class="az-header-left">
                    <a asp-controller="Dashboard" asp-action="Index" class="az-logo">
                        <i class="typcn typcn-radar"></i>
                        <span>Auditor</span>
                    </a>
                    <a href="#" id="azMenuShow" class="az-header-menu-icon d-lg-none" aria-label="Open menu">
                        <i class="fas fa-bars"></i>
                    </a>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="az-header-menu" id="azHeaderMenu">
                        <ul class="nav">
                            <li class="nav-item">
                                <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                                    <i class="typcn typcn-th-large-outline"></i> Dashboard
                                </a>
                            </li>

                            @if (isManager)
                            {
                                <li class="nav-item">
                                    <a href="#" class="nav-link with-sub">
                                        <i class="typcn typcn-plane-outline"></i> Airports
                                    </a>
                                    <nav class="az-menu-sub">
                                        <a asp-controller="Airports" asp-action="Index" class="nav-link">
                                            <i class="typcn typcn-th-list"></i> Airports
                                        </a>
                                        <a asp-controller="AuditSites" asp-action="Index" class="nav-link">
                                            <i class="typcn typcn-location-outline"></i> Audit Sites
                                        </a>
                                        <a asp-controller="Departments" asp-action="Index" class="nav-link">
                                            <i class="typcn typcn-group-outline"></i> Departments
                                        </a>
                                    </nav>
                                </li>

                                <li class="nav-item">
                                    <a href="#" class="nav-link with-sub">
                                        <i class="typcn typcn-clipboard"></i> Questions &amp; Templates
                                    </a>
                                    <nav class="az-menu-sub">
                                        <a asp-controller="QuestionBanks" asp-action="Index" class="nav-link">
                                            <i class="typcn typcn-document-text"></i> Question Bank
                                        </a>
                                        <a asp-controller="QuestionCategories" asp-action="Index" class="nav-link">
                                            <i class="typcn typcn-folder"></i> Categories
                                        </a>
                                        <a asp-controller="AuditTemplates" asp-action="Index" class="nav-link">
                                            <i class="typcn typcn-clipboard"></i> Audit Templates
                                        </a>
                                        <a asp-controller="ReferenceLists" asp-action="Index" class="nav-link">
                                            <i class="typcn typcn-th-list"></i> Reference Lists
                                        </a>
                                    </nav>
                                </li>
                            }

                            <li class="nav-item">
                                <a href="#" class="nav-link with-sub">
                                    <i class="typcn typcn-flash-outline"></i> Audits
                                </a>
                                <nav class="az-menu-sub">
                                    @if (isManager)
                                    {
                                        <a asp-controller="AuditSchedules" asp-action="Index" class="nav-link">
                                            <i class="typcn typcn-calendar-outline"></i> Schedules
                                        </a>
                                    }
                                    <a asp-controller="AuditExecutions" asp-action="Index" class="nav-link">
                                        <i class="typcn typcn-media-play-outline"></i> @(isAuditor ? "My Audits" : "Audit Executions")
                                    </a>
                                    @if (isManager)
                                    {
                                        <a asp-controller="ScheduleChangeRequests" asp-action="Index" class="nav-link">
                                            <i class="typcn typcn-refresh-outline"></i> Change Requests
                                        </a>
                                    }
                                </nav>
                            </li>

                            @if (!isAuditor)
                            {
                                <li class="nav-item">
                                    <a asp-controller="Reports" asp-action="Index" class="nav-link">
                                        <i class="typcn typcn-chart-bar-outline"></i> Reports
                                    </a>
                                </li>
                            }

                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a asp-controller="AppUsers" asp-action="Index" class="nav-link">
                                        <i class="typcn typcn-user-outline"></i> Users
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="az-header-right">
                        <details class="user-menu">
                            <summary aria-label="Account menu">
                                <span class="user-avatar" aria-hidden="true">@initials</span>
                                <span class="user-menu-name">@displayName</span>
                                <i class="fas fa-chevron-down user-menu-caret" aria-hidden="true"></i>
                            </summary>
                            <div class="user-menu-panel">
                                <div class="user-menu-header">
                                    <span class="user-avatar user-avatar-lg" aria-hidden="true">@initials</span>
                                    <div>
                                        <div class="user-menu-fullname">@displayName</div>
                                        <div class="user-menu-meta">
                                            @role@(string.IsNullOrEmpty(employeeNumber) ? "" : $" · {employeeNumber}")
                                        </div>
                                    </div>
                                </div>
                                <a href="/account/password" class="user-menu-item">
                                    <i class="fas fa-key"></i> Change password
                                </a>
                                <form action="/logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="user-menu-item user-menu-signout">
                                        <i class="fas fa-sign-out-alt"></i> Sign out
                                    </button>
                                </form>
                            </div>
                        </details>
                    </div>
                }
            </div>
        </div>
    </header>

    <div class="auditor-content-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @await Html.PartialAsync("_Footer")

    <script src="~/Azia/lib/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/pagination.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Share the frozen nav bar's height so sticky elements below it can sit just under it.
            const header = document.querySelector('.auditor-header-wrapper');
            if (header) {
                const setHeight = () => document.documentElement.style.setProperty('--header-h', header.querySelector('.az-header').offsetHeight + 'px');
                setHeight();
                window.addEventListener('resize', setHeight);
            }

            const menuToggle = document.getElementById('azMenuShow');
            const headerMenu = document.getElementById('azHeaderMenu');

            if (menuToggle && headerMenu) {
                menuToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    headerMenu.classList.toggle('show');
                });
            }

            // Sub-menus open on click (and on hover via CSS on wide screens).
            document.querySelectorAll('.az-header-menu .with-sub').forEach(function (link) {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const item = link.closest('.nav-item');
                    document.querySelectorAll('.az-header-menu .nav-item.show').forEach(function (other) {
                        if (other !== item) other.classList.remove('show');
                    });
                    item.classList.toggle('show');
                });
            });

            // Close menus when clicking elsewhere.
            document.addEventListener('click', function (e) {
                if (headerMenu && menuToggle && !headerMenu.contains(e.target) && !menuToggle.contains(e.target)) {
                    headerMenu.classList.remove('show');
                    headerMenu.querySelectorAll('.nav-item.show').forEach(function (i) { i.classList.remove('show'); });
                }
                const userMenu = document.querySelector('.user-menu');
                if (userMenu && userMenu.open && !userMenu.contains(e.target)) userMenu.open = false;
            });
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
