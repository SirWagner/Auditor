@model Auditor.ViewModels.Users.AppUserFormViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="form-page-container">
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-action="Index">Users</a>
        <span>›</span>
        <span>Create New</span>
    </div>

    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>Create New User</h1>
            <p>Give a person access to Auditor</p>
        </div>
        <div class="form-page-meta"><span class="form-meta-badge">New Entry</span></div>
    </div>

    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-header">
                <h2><i class="typcn typcn-user-add-outline"></i> User Details</h2>
            </div>
            <div class="form-main-content">
                <form asp-action="Create" method="post" novalidate id="userForm">
                    <partial name="_UserForm" model="Model" />
                </form>
            </div>
            <div class="form-main-footer">
                <a asp-action="Index" class="btn-cancel"><i class="fas fa-times"></i> Cancel</a>
                <button form="userForm" type="submit" class="btn-submit"><i class="fas fa-plus"></i> Create User</button>
            </div>
        </div>
    </div>
</div>
