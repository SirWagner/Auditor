@model IEnumerable<Auditor.Models.AppUser>
@using Auditor.Security
@{
    ViewData["Title"] = "Users";
    var query = ViewBag.Query as string;
    var roleFilter = ViewBag.Role as string;
}

<div class="list-container">
    <div class="list-header">
        <div class="list-header-content">
            <h1>👥 Users</h1>
            <p class="list-header-subtitle">Who can sign in, and what each person can do</p>
        </div>
        <a asp-action="Create" class="btn-list-primary">
            <span>+</span> Create New User
        </a>
    </div>

    <partial name="_PageAlerts" />

    <form method="get" class="list-filters">
        <input type="search" name="q" value="@query" class="form-control" placeholder="Search by name, email or employee number" aria-label="Search users" />
        <select name="role" class="form-control" aria-label="Filter by role" onchange="this.form.submit()">
            <option value="">All roles</option>
            @foreach (var r in Roles.All)
            {
                <option value="@r" selected="@(r == roleFilter)">@r</option>
            }
        </select>
        <button type="submit" class="action-btn btn-view">Search</button>
    </form>

    @if (Model.Any())
    {
        <div class="list-table-wrapper">
            <table class="list-table table">
                <thead>
                    <tr>
                        <th style="width: 20%;">Name</th>
                        <th style="width: 13%;">Employee No.</th>
                        <th style="width: 18%;">Email</th>
                        <th style="width: 8%;">Airport</th>
                        <th style="width: 10%;">Role</th>
                        <th style="width: 9%;">Status</th>
                        <th style="width: 10%;">Last Sign-in</th>
                        <th style="width: 12%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><div class="cell-name">@user.DisplayName</div></td>
                            <td><span class="cell-code">@user.EmployeeNumber</span></td>
                            <td><div class="cell-secondary">@user.Email</div></td>
                            <td><span class="cell-code" title="@(user.Airport?.Name ?? "All airports")">@(user.Airport?.Code ?? "All")</span></td>
                            <td><span class="role-pill role-pill-@user.Role">@(user.Role ?? "—")</span></td>
                            <td>
                                <span class="status-pill @(user.IsActive ? "status-pill-active" : "status-pill-inactive")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td><div class="cell-secondary">@(user.LastLoginDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "Never")</div></td>
                            <td>
                                <div class="list-actions">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="action-btn btn-edit">Edit</a>
                                    <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post">
                                        <button type="submit" class="action-btn @(user.IsActive ? "btn-delete" : "btn-view")">
                                            @(user.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="list-table-wrapper">
            <div class="list-empty-state">
                <div class="empty-state-icon">👥</div>
                <h2 class="empty-state-title">No users match</h2>
                <p class="empty-state-text">Clear the search, or create a new user.</p>
            </div>
        </div>
    }
</div>
