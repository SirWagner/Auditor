@model Auditor.Models.Airport

@{
    ViewData["Title"] = "Delete Airport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-page-container">
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-controller="Airports" asp-action="Index">Airports</a>
        <span>›</span>
        <span>Delete</span>
    </div>

    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>Delete Airport</h1>
            <p>@Model.Name (@Model.Code)</p>
        </div>
    </div>

    <partial name="_PageAlerts" />

    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-content">
                @if (Model.AuditSites.Count > 0)
                {
                    <div class="page-alert page-alert-error" role="alert">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>
                            This airport has @Model.AuditSites.Count audit site(s), so it can't be deleted.
                            <a asp-action="Edit" asp-route-id="@Model.Id">Set it to Inactive</a> to stop new sites being added.
                        </span>
                    </div>
                }
                else
                {
                    <p>Delete <strong>@Model.Name</strong> and its areas permanently? This can't be undone.</p>
                }
            </div>

            <div class="form-main-footer">
                <a asp-action="Index" class="btn-cancel">
                    <i class="fas fa-arrow-left"></i>
                    Back to List
                </a>
                @if (Model.AuditSites.Count == 0)
                {
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn-submit" style="background: var(--enterprise-error);">
                            <i class="fas fa-trash"></i>
                            Delete Airport
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
