@model Auditor.Models.AuditExecution
@using Auditor.Models.Lookups
@using Auditor.ViewModels.AuditExecution
@{
    var render = (AuditExecutionRenderViewModel)ViewBag.Render;
    var canReview = ViewBag.CanReview as bool? ?? false;
    var result = Model.AuditExecutionResult;
    var isOwner = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.AuditorId.ToString();
    ViewData["Title"] = render.AuditName;
    ViewData["ReadOnly"] = true;
}

<div class="exec-container" style="padding-bottom:40px;">
    <div class="details-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-action="Index">Audit Executions</a>
        <span>›</span>
        <span>#@Model.Id</span>
    </div>

    <div class="exec-header">
        <div>
            <h1>@render.AuditName</h1>
            <div class="exec-meta">
                <span><i class="typcn typcn-location-outline"></i> @render.SiteName</span>
                @if (!string.IsNullOrEmpty(render.AirportName))
                {
                    <span><i class="typcn typcn-plane-outline"></i> @render.AirportName</span>
                }
                <span><i class="typcn typcn-user-outline"></i> @render.AuditorName</span>
                <span><i class="far fa-calendar"></i> Scheduled @render.ScheduledDate.ToString("dd MMM yyyy HH:mm")</span>
                @if (Model.SubmissionDate != null)
                {
                    <span><i class="fas fa-paper-plane"></i> Submitted @Model.SubmissionDate.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                }
            </div>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
            <span class="status-pill @ExecutionStatuses.PillClass(Model.Status)">@ExecutionStatuses.Label(Model.Status)</span>
            @if (isOwner && Model.Status is ExecutionStatuses.InProgress or ExecutionStatuses.Rejected)
            {
                <a asp-action="Execute" asp-route-executionId="@Model.Id" class="btn-details-primary"><i class="fas fa-edit"></i> Continue</a>
            }
            @if (isOwner && Model.Status == ExecutionStatuses.PendingAcceptance)
            {
                <a asp-action="Accept" asp-route-executionId="@Model.Id" class="btn-details-primary"><i class="fas fa-check"></i> Accept</a>
            }
        </div>
    </div>

    <partial name="_PageAlerts" />

    @if (!string.IsNullOrEmpty(Model.RejectionReason))
    {
        <div class="page-alert page-alert-error" role="alert">
            <i class="fas fa-info-circle"></i>
            <span><strong>@(Model.Status == ExecutionStatuses.Declined ? "Declined:" : "Returned for changes:")</strong> @Model.RejectionReason</span>
        </div>
    }

    @if (result != null)
    {
        <div class="dashboard-stats-grid" style="margin-bottom:20px;">
            <div class="stat-tile @(result.ScorePercentage < 80 ? "stat-tile-warning" : "")">
                <div class="stat-tile-value">@result.ScorePercentage.ToString("0.#")%</div>
                <div class="stat-tile-label">Compliance score</div>
            </div>
            <div class="stat-tile">
                <div class="stat-tile-value">@result.CompliantCount</div>
                <div class="stat-tile-label">Compliant</div>
            </div>
            <div class="stat-tile @(result.NonCompliantCount > 0 ? "stat-tile-warning" : "")">
                <div class="stat-tile-value">@result.NonCompliantCount</div>
                <div class="stat-tile-label">Not compliant</div>
            </div>
            <div class="stat-tile">
                <div class="stat-tile-value">@(result.NotApplicableCount ?? 0)</div>
                <div class="stat-tile-label">Not applicable</div>
            </div>
        </div>
    }

    @if (canReview)
    {
        <div class="details-info-card">
            <div class="details-info-card-header">
                <i class="fas fa-clipboard-check"></i>
                <h2>Review</h2>
            </div>
            <div class="details-info-card-body">
                <form asp-action="Review" asp-route-id="@Model.Id" method="post" style="display:inline;">
                    <input type="hidden" name="decision" value="close" />
                    <button type="submit" class="btn-submit"><i class="fas fa-check"></i> Approve and Close</button>
                </form>
                <form asp-action="Review" asp-route-id="@Model.Id" method="post" class="list-filters" style="margin-top:14px;">
                    <input type="hidden" name="decision" value="return" />
                    <input type="text" name="reason" class="form-control" placeholder="What should the auditor change?" required style="max-width:460px;" aria-label="Reason for returning" />
                    <button type="submit" class="action-btn btn-delete">Return for Changes</button>
                </form>
            </div>
        </div>
    }

    <div style="display:flex;justify-content:flex-end;margin:8px 0 4px;">
        <label style="font-size:13px;cursor:pointer;">
            <input type="checkbox" id="onlyIssues" /> Show only non-compliant answers
        </label>
    </div>

    <partial name="_SectionedQuestions" model="render" view-data="ViewData" />
</div>

@section Scripts {
    <script src="~/js/audit-sections.js" asp-append-version="true"></script>
    <script>
        // Hides compliant answers; tabs and groups left empty are hidden too.
        document.getElementById('onlyIssues')?.addEventListener('change', function () {
            window.auditSections?.filter(this.checked ? q => q.classList.contains('non-compliant') : null);
        });
    </script>
}
