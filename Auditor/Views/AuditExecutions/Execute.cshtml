@model Auditor.ViewModels.AuditExecution.AuditExecutionRenderViewModel
@using Auditor.Models.Lookups
@{
    ViewData["Title"] = Model.AuditName;
}

<div class="exec-container">
    <div class="details-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-action="Index">My Audits</a>
        <span>›</span>
        <span>@Model.AuditName</span>
    </div>

    <div class="exec-header">
        <div>
            <h1>@Model.AuditName</h1>
            <div class="exec-meta">
                <span><i class="typcn typcn-location-outline"></i> @Model.SiteName</span>
                @if (!string.IsNullOrEmpty(Model.AirportName))
                {
                    <span><i class="typcn typcn-plane-outline"></i> @Model.AirportName</span>
                }
                <span><i class="far fa-clock"></i> Due @Model.DueDate.ToString("dd MMM yyyy HH:mm")</span>
            </div>
        </div>
        <span class="status-pill @ExecutionStatuses.PillClass(Model.Status)">@ExecutionStatuses.Label(Model.Status)</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.ReturnReason))
    {
        <div class="page-alert page-alert-error" role="alert">
            <i class="fas fa-undo"></i>
            <span><strong>Returned by the reviewer:</strong> @Model.ReturnReason</span>
        </div>
    }

    @if (Model.Questions.Count == 0)
    {
        <div class="list-table-wrapper">
            <div class="list-empty-state">
                <div class="empty-state-icon">📝</div>
                <h2 class="empty-state-title">This template has no questions</h2>
                <p class="empty-state-text">Ask a manager to add questions to the template.</p>
            </div>
        </div>
    }

    <form id="auditForm" data-execution-id="@Model.ExecutionId" onsubmit="return false;">
        @Html.AntiForgeryToken()
        @* Progress bar, section tabs and questions; the progress bar stays pinned with the tabs. *@
        <partial name="_SectionedQuestions" model="Model" view-data='new ViewDataDictionary(ViewData) { ["ShowProgress"] = true }' />
    </form>
</div>

<div class="exec-actions">
    <button type="button" class="btn-cancel" id="saveDraftBtn"><i class="fas fa-save"></i> Save Draft</button>
    <button type="button" class="btn-submit" id="submitBtn"><i class="fas fa-paper-plane"></i> Submit Audit</button>
</div>

@section Scripts {
    <script src="~/js/audit-sections.js" asp-append-version="true"></script>
    <script src="~/js/answer-fields.js" asp-append-version="true"></script>
    <script src="~/js/audit-execute.js" asp-append-version="true"></script>
}
