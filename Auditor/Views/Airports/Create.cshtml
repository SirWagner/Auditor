@model Auditor.ViewModels.Airport.AirportFormViewModel

@{
    ViewData["Title"] = "Create Airport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-page-container">
    <!-- Breadcrumb Navigation -->
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-controller="Airports" asp-action="Index">Airports</a>
        <span>›</span>
        <span>Create New</span>
    </div>

    <!-- Page Title Section -->
    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>Create New Airport</h1>
            <p>Add a new airport to your audit management system</p>
        </div>
        <div class="form-page-meta">
            <span class="form-meta-badge">New Entry</span>
        </div>
    </div>

    <!-- Form Layout with Sidebar -->
    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-header">
                <h2>
                    <i class="typcn typcn-plane-outline"></i>
                    Airport Information
                </h2>
            </div>

            <div class="form-main-content">
                <form asp-action="Create" method="post" novalidate id="createAirportForm">
                    <partial name="_AirportForm" model="Model" />
                </form>
            </div>

            <div class="form-main-footer">
                <a asp-action="Index" class="btn-cancel">
                    <i class="fas fa-times"></i>
                    Cancel
                </a>
                <button form="createAirportForm" type="submit" class="btn-submit">
                    <i class="fas fa-plus"></i>
                    Create Airport
                </button>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="form-sidebar">
            <div class="form-sidebar-card">
                <h3>
                    <i class="fas fa-info-circle"></i>
                    Information
                </h3>
                <p>
                    Airport code and name must both be unique. Codes are saved in upper case, and extra spaces in the name are removed before the check.
                </p>
            </div>

            <div class="form-sidebar-card form-sidebar-help">
                <h3>
                    <i class="fas fa-question-circle"></i>
                    Need Help?
                </h3>
                <p>
                    Fields marked with <span class="required">*</span> are required. Areas are optional here, but audit sites can only use terminals and locations listed on their airport.
                </p>
            </div>

            <div class="form-sidebar-card">
                <h3>
                    <i class="fas fa-lightbulb"></i>
                    Tips
                </h3>
                <p>
                    Add as many terminals, terminal locations, airside and landside areas as the airport has — each list accepts multiple values.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/airport-form.js" asp-append-version="true"></script>
}
