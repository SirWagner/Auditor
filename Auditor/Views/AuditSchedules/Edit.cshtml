@model Auditor.ViewModels.AuditSchedule.AuditScheduleFormViewModel
@{
    ViewData["Title"] = "Edit Schedule";
}

<div class="form-page-container">
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-action="Index">Audit Schedules</a>
        <span>›</span>
        <a asp-action="Details" asp-route-id="@Model.Id">Schedule #@Model.Id</a>
        <span>›</span>
        <span>Edit</span>
    </div>

    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>Edit Schedule #@Model.Id</h1>
            <p>Changes are only possible before the audit starts</p>
        </div>
        <div class="form-page-meta"><span class="form-meta-badge">Editing</span></div>
    </div>

    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-header">
                <h2><i class="fas fa-calendar-check"></i> Schedule Details</h2>
            </div>
            <div class="form-main-content">
                <form asp-action="Edit" method="post" novalidate id="scheduleForm">
                    <input type="hidden" asp-for="Id" />
                    <partial name="_ScheduleForm" model="Model" />
                </form>
            </div>
            <div class="form-main-footer">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel"><i class="fas fa-times"></i> Cancel</a>
                <button form="scheduleForm" type="submit" class="btn-submit"><i class="fas fa-save"></i> Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/schedule-form.js" asp-append-version="true"></script>
}
