@model Auditor.Models.AuditExecution
@{
    ViewData["Title"] = "Accept Audit";
    var schedule = Model.Schedule;
}

<div class="form-page-container">
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-action="Index">My Audits</a>
        <span>›</span>
        <span>Accept</span>
    </div>

    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>@schedule.Template.Name</h1>
            <p>@schedule.Site.Name · @schedule.Site.Airport?.Name</p>
        </div>
    </div>

    <partial name="_PageAlerts" />

    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-content">
                <div class="details-info-grid" style="margin-bottom:24px;">
                    <div class="details-info-field">
                        <div class="details-info-label">Scheduled</div>
                        <div class="details-info-value"><strong>@schedule.ScheduledDate.ToString("dddd, dd MMM yyyy HH:mm")</strong></div>
                    </div>
                    <div class="details-info-field">
                        <div class="details-info-label">Due</div>
                        <div class="details-info-value"><strong>@schedule.DueDate.ToString("dddd, dd MMM yyyy HH:mm")</strong></div>
                    </div>
                </div>

                <p>Accept to open the checklist. You can save your answers as a draft and come back before submitting.</p>

                <form asp-action="Accept" method="post" style="margin:16px 0 28px;">
                    <input type="hidden" name="executionId" value="@Model.Id" />
                    <input type="hidden" name="confirm" value="true" />
                    <button type="submit" class="btn-submit"><i class="fas fa-check"></i> Accept and Start</button>
                </form>

                <details>
                    <summary style="cursor:pointer;font-weight:600;color:#b91c1c;">I can't do this audit</summary>
                    <form asp-action="Decline" method="post" class="list-filters" style="margin-top:12px;">
                        <input type="hidden" name="executionId" value="@Model.Id" />
                        <input type="text" name="reason" class="form-control" placeholder="Reason, e.g. on leave that day" required style="max-width:420px;" aria-label="Reason for declining" />
                        <button type="submit" class="action-btn btn-delete">Decline</button>
                    </form>
                </details>
            </div>
        </div>
    </div>
</div>
