@model Auditor.ViewModels.Airport.AirportFormViewModel

@{
    ViewData["Title"] = "Edit Airport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-page-container">
    <!-- Breadcrumb Navigation -->
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-controller="Airports" asp-action="Index">Airports</a>
        <span>›</span>
        <span>Edit</span>
    </div>

    <!-- Page Title Section -->
    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>Edit Airport</h1>
            <p>Update the details for @Model.Name</p>
        </div>
        <div class="form-page-meta">
            <span class="form-meta-badge">Editing</span>
        </div>
    </div>

    <!-- Form Layout with Sidebar -->
    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-header">
                <h2>
                    <i class="typcn typcn-plane-outline"></i>
                    Airport Information
                </h2>
            </div>

            <div class="form-main-content">
                <form asp-action="Edit" method="post" novalidate id="editAirportForm">
                    <input type="hidden" asp-for="Id" />
                    <partial name="_AirportForm" model="Model" />
                </form>
            </div>

            <div class="form-main-footer">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel">
                    <i class="fas fa-times"></i>
                    Cancel
                </a>
                <button form="editAirportForm" type="submit" class="btn-submit">
                    <i class="fas fa-save"></i>
                    Save Changes
                </button>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="form-sidebar">
            <div class="form-sidebar-card">
                <h3>
                    <i class="fas fa-info-circle"></i>
                    Information
                </h3>
                <p>
                    Airport code and name must both stay unique across all airports.
                </p>
            </div>

            <div class="form-sidebar-card form-sidebar-help">
                <h3>
                    <i class="fas fa-question-circle"></i>
                    Removing areas
                </h3>
                <p>
                    A terminal or location that an audit site uses can't be removed. Move the site to another area first.
                </p>
            </div>

            <div class="form-sidebar-card">
                <h3>
                    <i class="fas fa-lightbulb"></i>
                    Deactivating
                </h3>
                <p>
                    Set Active Status to Inactive to stop new audit sites being created here. Existing sites are unaffected.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/airport-form.js" asp-append-version="true"></script>
}
