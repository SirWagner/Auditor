@model IEnumerable<Auditor.Models.AuditExecution>
@using Auditor.Models.Lookups
@using Auditor.Security
@{
    var isAuditor = User.IsInRole(Roles.Auditor);
    ViewData["Title"] = isAuditor ? "My Audits" : "Audit Executions";
    var toStart = ViewBag.ToStart as List<AuditSchedule> ?? new();
    var filterPanel = (Auditor.ViewModels.Shared.AuditFilterPanel)ViewBag.Filter;
}

<div class="list-container">
    <div class="list-header">
        <div class="list-header-content">
            <h1>@(isAuditor ? "🧭 My Audits" : "⚙️ Audit Executions")</h1>
            <p class="list-header-subtitle">
                @(isAuditor ? "Audits assigned to you, and the ones you've already started" : "Every audit run, with its status and compliance score")
            </p>
        </div>
    </div>

    <partial name="_PageAlerts" />

    <partial name="_AuditFilter" model="filterPanel" />

    @if (isAuditor)
    {
        <h2 class="exec-section" style="margin-top:0;">Ready to start (@toStart.Count)</h2>
        @if (toStart.Count == 0)
        {
            <div class="list-table-wrapper" style="margin-bottom:24px;">
                <div class="list-empty-state" style="padding:28px;">
                    <p class="empty-state-text" style="margin:0;">No new audits are assigned to you.</p>
                </div>
            </div>
        }
        else
        {
            <div class="list-table-wrapper" style="margin-bottom:28px;">
                <table class="list-table table">
                    <thead>
                        <tr>
                            <th>Audit</th>
                            <th>Site</th>
                            <th>Scheduled</th>
                            <th>Due</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in toStart)
                        {
                            <tr>
                                <td><div class="cell-name">@s.Template.Name</div></td>
                                <td><div class="cell-name">@s.Site.Name</div><small class="text-muted">@s.Site.Airport?.Code</small></td>
                                <td><div class="cell-secondary">@s.ScheduledDate.ToString("dd MMM yyyy HH:mm")</div></td>
                                <td><div class="cell-secondary">@s.DueDate.ToString("dd MMM yyyy HH:mm")</div></td>
                                <td>
                                    <form asp-action="Start" asp-route-scheduleId="@s.Id" method="post">
                                        <button type="submit" class="action-btn btn-view" style="background:#16a34a;color:#fff;border-color:#16a34a;">Start</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <h2 class="exec-section">Started</h2>
    }


    @if (Model.Any())
    {
        <div class="list-table-wrapper">
            <table class="list-table table">
                <thead>
                    <tr>
                        <th style="width:28%;">Audit</th>
                        <th style="width:20%;">Site</th>
                        @if (!isAuditor)
                        {
                            <th style="width:14%;">Auditor</th>
                        }
                        <th style="width:12%;">Scheduled</th>
                        <th style="width:12%;">Status</th>
                        <th style="width:7%;">Score</th>
                        <th style="width:7%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        var action = e.Status switch
                        {
                            ExecutionStatuses.PendingAcceptance when isAuditor => ("Accept", "Accept"),
                            ExecutionStatuses.InProgress or ExecutionStatuses.Rejected when isAuditor => ("Execute", "Continue"),
                            _ => ("Details", "View"),
                        };
                        <tr>
                            <td><div class="cell-name">@e.Schedule.Template.Name</div></td>
                            <td><div class="cell-name">@e.Schedule.Site.Name</div><small class="text-muted">@e.Schedule.Site.Airport?.Code</small></td>
                            @if (!isAuditor)
                            {
                                <td><div class="cell-secondary">@e.Auditor?.DisplayName</div></td>
                            }
                            <td><div class="cell-secondary">@e.Schedule.ScheduledDate.ToString("dd MMM yyyy")</div></td>
                            <td><span class="status-pill @ExecutionStatuses.PillClass(e.Status)">@ExecutionStatuses.Label(e.Status)</span></td>
                            <td><div class="cell-secondary">@(e.AuditExecutionResult == null ? "—" : e.AuditExecutionResult.ScorePercentage.ToString("0.#") + "%")</div></td>
                            <td>
                                @if (action.Item1 == "Details")
                                {
                                    <a asp-action="Details" asp-route-id="@e.Id" class="action-btn btn-view">View</a>
                                }
                                else
                                {
                                    <a asp-action="@action.Item1" asp-route-executionId="@e.Id" class="action-btn btn-edit">@action.Item2</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="list-table-wrapper">
            <div class="list-empty-state">
                <div class="empty-state-icon">🚀</div>
                <h2 class="empty-state-title">Nothing here yet</h2>
                <p class="empty-state-text">@(isAuditor ? "Start an assigned audit above and it will appear here." : "Audits appear here once an auditor starts them.")</p>
            </div>
        </div>
    }
</div>
