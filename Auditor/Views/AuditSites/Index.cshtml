@model IEnumerable<Auditor.Models.AuditSite>
@using Auditor.Models.Lookups

@{
    ViewData["Title"] = "Audit Sites";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="list-container">
    <div class="list-header">
        <div class="list-header-content">
            <h1>📋 Audit Sites</h1>
            <p class="list-header-subtitle">Manage and monitor your specific audit locations</p>
        </div>
        @if (Model.Any())
        {
            <a asp-action="Create" class="btn-list-primary">
                <span>+</span> Create New Site
            </a>
        }
    </div>

    <partial name="_PageAlerts" />

    @if (Model.Any())
    {
        <div class="list-table-wrapper">
            <table class="list-table table site-table">
                <thead>
                    <tr>
                        <th style="width: 20%;">Site</th>
                        <th style="width: 17%;">Airport</th>
                        <th style="width: 18%;">Category</th>
                        <th style="width: 12%;">Department</th>
                        <th style="width: 9%;">Status</th>
                        <th style="width: 10%;">Created</th>
                        <th style="width: 14%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="cell-name">@item.Name</div>
                                @if (!string.IsNullOrEmpty(item.SiteType))
                                {
                                    <small class="text-muted">@item.SiteType</small>
                                }
                            </td>
                            <td>
                                <span class="cell-code">@item.Airport?.Name</span>
                                @if (item.Terminal != null)
                                {
                                    <div><small class="text-muted">@item.Terminal.Name</small></div>
                                }
                            </td>
                            <td>
                                @{
                                    var category = string.Join(" › ", new[] { item.SiteCategory, item.SiteSubCategory }.Where(v => !string.IsNullOrEmpty(v)));
                                }
                                <div class="cell-secondary">@(category.Length > 0 ? category : "Not classified")</div>
                            </td>
                            <td>
                                <div class="cell-secondary">@item.Department?.Name</div>
                            </td>
                            <td>
                                <span class="status-pill @(item.Status == AuditSiteLookups.Active ? "status-pill-active" : "status-pill-inactive")">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <div class="cell-secondary">@item.CreatedDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                <div class="list-actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-view">View</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                          data-confirm="Delete &quot;@item.Name&quot;? This can't be undone."
                                          onsubmit="return confirm(this.dataset.confirm);">
                                        <button type="submit" class="action-btn btn-delete">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="list-table-wrapper">
            <div class="list-empty-state">
                <div class="empty-state-icon">🔎</div>
                <h2 class="empty-state-title">No Audit Sites Found</h2>
                <p class="empty-state-text">There are currently no audit sites registered in the system.</p>
                <a asp-action="Create" class="btn-list-primary">
                    <span>+</span> Create First Site
                </a>
            </div>
        </div>
    }
</div>
