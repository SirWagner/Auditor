@model Auditor.ViewModels.AuditSchedule.AuditScheduleFormViewModel
@{
    ViewData["Title"] = "Schedule an Audit";
}

<div class="form-page-container">
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-action="Index">Audit Schedules</a>
        <span>›</span>
        <span>Create New</span>
    </div>

    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>Schedule an Audit</h1>
            <p>Pick the site and template, set the dates, and assign auditors</p>
        </div>
        <div class="form-page-meta"><span class="form-meta-badge">New Entry</span></div>
    </div>

    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-header">
                <h2><i class="fas fa-calendar-check"></i> Schedule Details</h2>
            </div>
            <div class="form-main-content">
                <form asp-action="Create" method="post" novalidate id="scheduleForm">
                    <partial name="_ScheduleForm" model="Model" />
                </form>
            </div>
            <div class="form-main-footer">
                <a asp-action="Index" class="btn-cancel"><i class="fas fa-times"></i> Cancel</a>
                <button form="scheduleForm" type="submit" class="btn-submit"><i class="fas fa-calendar-plus"></i> Create Schedule</button>
            </div>
        </div>

        <div class="form-sidebar">
            <div class="form-sidebar-card">
                <h3><i class="fas fa-route"></i> What happens next</h3>
                <p>Each assigned auditor sees the audit under <strong>My Audits</strong>. They accept it, complete the checklist on site, and submit it for your review.</p>
            </div>
            <div class="form-sidebar-card form-sidebar-help">
                <h3><i class="fas fa-clock"></i> Due dates</h3>
                <p>A schedule nobody has started by its due date is cancelled automatically, with the reason recorded.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/schedule-form.js" asp-append-version="true"></script>
}
