@model Auditor.Models.Airport
@using Auditor.Models
@using Auditor.Models.Lookups

@{
    ViewData["Title"] = "Airport Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="details-page-container">
    <!-- Breadcrumb -->
    <div class="details-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-controller="Airports" asp-action="Index">Airports</a>
        <span>›</span>
        <span>@Model.Name</span>
    </div>

    <!-- Page Header -->
    <div class="details-header">
        <h1>
            <i class="typcn typcn-plane"></i>
            @Model.Name
        </h1>
        <div class="details-header-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-details-primary">
                <i class="fas fa-edit"></i>
                Edit
            </a>
            <a asp-action="Index" class="btn-details-secondary">
                <i class="fas fa-arrow-left"></i>
                Back
            </a>
        </div>
    </div>

    <partial name="_PageAlerts" />

    <!-- Airport Information -->
    <div class="details-info-card">
        <div class="details-info-card-header">
            <i class="typcn typcn-document-text"></i>
            <h2>Airport Information</h2>
        </div>
        <div class="details-info-card-body">
            <div class="details-info-grid">
                <div class="details-info-field">
                    <div class="details-info-label">Airport Name</div>
                    <div class="details-info-value"><strong>@Model.Name</strong></div>
                </div>
                <div class="details-info-field">
                    <div class="details-info-label">Code</div>
                    <div class="details-info-value">
                        <span class="details-code">@Model.Code</span>
                    </div>
                </div>
                <div class="details-info-field">
                    <div class="details-info-label">Airport Type</div>
                    <div class="details-info-value"><strong>@(Model.AirportType ?? "—")</strong></div>
                </div>
                <div class="details-info-field">
                    <div class="details-info-label">Status</div>
                    <div class="details-info-value">
                        <span class="status-pill @(Model.IsActive ? "status-pill-active" : "status-pill-inactive")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>
                <div class="details-info-field">
                    <div class="details-info-label">Region</div>
                    <div class="details-info-value"><strong>@(Model.Region ?? "—")</strong></div>
                </div>
                <div class="details-info-field">
                    <div class="details-info-label">Country</div>
                    <div class="details-info-value"><strong>@(Model.Country ?? "—")</strong></div>
                </div>
                <div class="details-info-field">
                    <div class="details-info-label">Airport Manager</div>
                    <div class="details-info-value"><strong>@(Model.AirportManager ?? "—")</strong></div>
                </div>
                <div class="details-info-field">
                    <div class="details-info-label">Email Address</div>
                    <div class="details-info-value">
                        @if (!string.IsNullOrEmpty(Model.EmailAddress))
                        {
                            <a href="mailto:@Model.EmailAddress">@Model.EmailAddress</a>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </div>
                </div>
                <div class="details-info-field">
                    <div class="details-info-label">Tel Number</div>
                    <div class="details-info-value">@(Model.TelNumber ?? "—")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Airport Areas -->
    <div class="details-info-card">
        <div class="details-info-card-header">
            <i class="typcn typcn-map"></i>
            <h2>Airport Areas</h2>
        </div>
        <div class="details-info-card-body">
            <div class="details-info-grid">
                @foreach (var areaType in AirportLookups.AreaTypes)
                {
                    var names = Model.Locations
                        .Where(l => l.AreaType == areaType.Key)
                        .Select(l => l.Name)
                        .OrderBy(n => n)
                        .ToList();

                    <div class="details-info-field">
                        <div class="details-info-label">@areaType.Value</div>
                        <div class="details-info-value">
                            @if (names.Count == 0)
                            {
                                <span class="area-empty">None added</span>
                            }
                            else
                            {
                                <div class="area-tag-list">
                                    @foreach (var name in names)
                                    {
                                        <span class="area-tag">@name</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Audit Sites Section -->
    <div class="details-section">
        <h2 class="details-section-title">
            <i class="typcn typcn-location-outline"></i>
            Audit Sites (@(Model.AuditSites?.Count ?? 0))
        </h2>
    </div>

    @if (Model.AuditSites?.Count > 0)
    {
        <div class="details-table-wrapper">
            <table class="details-table">
                <thead>
                    <tr>
                        <th style="width: 22%;">Site Name</th>
                        <th style="width: 22%;">Category</th>
                        <th style="width: 15%;">Department</th>
                        <th style="width: 11%;">Status</th>
                        <th style="width: 14%;">Created Date</th>
                        <th style="width: 16%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var site in Model.AuditSites.OrderByDescending(s => s.CreatedDate))
                    {
                        <tr>
                            <td>
                                <strong>@site.Name</strong>
                                @if (site.Terminal != null)
                                {
                                    <div class="text-muted">@site.Terminal.Name</div>
                                }
                            </td>
                            <td>
                                @(string.Join(" › ", new[] { site.SiteCategory, site.SiteSubCategory, site.SiteType }.Where(v => !string.IsNullOrEmpty(v))))
                            </td>
                            <td>@site.Department?.Name</td>
                            <td>
                                <span class="status-pill @(site.Status == AuditSiteLookups.Active ? "status-pill-active" : "status-pill-inactive")">
                                    @site.Status
                                </span>
                            </td>
                            <td>@site.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="details-table-actions">
                                    <a asp-controller="AuditSites" asp-action="Details" asp-route-id="@site.Id" class="details-action-btn btn-view">
                                        <i class="fas fa-eye"></i>
                                        View
                                    </a>
                                    <a asp-controller="AuditSites" asp-action="Edit" asp-route-id="@site.Id" class="details-action-btn btn-edit">
                                        <i class="fas fa-edit"></i>
                                        Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="details-table-wrapper">
            <div class="details-empty-state">
                <div class="details-empty-state-icon">📭</div>
                <h3 class="details-empty-state-title">No Audit Sites</h3>
                <p class="details-empty-state-text">No audit sites have been registered for this airport</p>
                @if (Model.IsActive)
                {
                    <a asp-controller="AuditSites" asp-action="Create" asp-route-airportId="@Model.Id" class="btn-details-primary">
                        <i class="fas fa-plus"></i>
                        Add an Audit Site
                    </a>
                }
            </div>
        </div>
    }
</div>
