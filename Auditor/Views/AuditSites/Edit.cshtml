@model Auditor.ViewModels.AuditSite.AuditSiteFormViewModel

@{
    ViewData["Title"] = "Edit Audit Site";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-page-container">
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-controller="AuditSites" asp-action="Index">Audit Sites</a>
        <span>›</span>
        <span>Edit</span>
    </div>

    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>Edit Audit Site</h1>
            <p>Update the details for @Model.Name</p>
        </div>
        <div class="form-page-meta">
            <span class="form-meta-badge">Editing</span>
        </div>
    </div>

    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-header">
                <h2>
                    <i class="typcn typcn-location-outline"></i>
                    Audit Site Details
                </h2>
            </div>

            <div class="form-main-content">
                <form asp-action="Edit" method="post" novalidate id="editAuditSiteForm">
                    <input type="hidden" asp-for="Id" />
                    <partial name="_AuditSiteForm" model="Model" />
                </form>
            </div>

            <div class="form-main-footer">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel">
                    <i class="fas fa-times"></i>
                    Cancel
                </a>
                <button form="editAuditSiteForm" type="submit" class="btn-submit">
                    <i class="fas fa-save"></i>
                    Save Changes
                </button>
            </div>
        </div>

        <div class="form-sidebar">
            <div class="form-sidebar-card">
                <h3>
                    <i class="fas fa-info-circle"></i>
                    About Audit Sites
                </h3>
                <p>
                    Audit sites are the specific places within an airport where audits are conducted.
                </p>
            </div>

            <div class="form-sidebar-card form-sidebar-help">
                <h3>
                    <i class="fas fa-question-circle"></i>
                    Need Help?
                </h3>
                <p>
                    Fields marked with <span class="required">*</span> are required.
                    Inactive sites can't be edited — reactivate them first with Change Status on the site's details page.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/audit-site-form.js" asp-append-version="true"></script>
}
