@model Auditor.ViewModels.AuditSite.AuditSiteFormViewModel

@{
    ViewData["Title"] = "Create Audit Site";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-page-container">
    <!-- Breadcrumb Navigation -->
    <div class="form-page-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span>›</span>
        <a asp-controller="AuditSites" asp-action="Index">Audit Sites</a>
        <span>›</span>
        <span>Create New</span>
    </div>

    <!-- Page Title Section -->
    <div class="form-page-title-section">
        <div class="form-page-title-content">
            <h1>Create New Audit Site</h1>
            <p>Add a site within an airport where audits are conducted</p>
        </div>
        <div class="form-page-meta">
            <span class="form-meta-badge">New Entry</span>
        </div>
    </div>

    <!-- Form Layout with Sidebar -->
    <div class="form-wrapper">
        <div class="form-main">
            <div class="form-main-header">
                <h2>
                    <i class="typcn typcn-location-outline"></i>
                    Audit Site Details
                </h2>
            </div>

            <div class="form-main-content">
                <form asp-action="Create" method="post" novalidate id="createAuditSiteForm">
                    <partial name="_AuditSiteForm" model="Model" />
                </form>
            </div>

            <div class="form-main-footer">
                <a asp-action="Index" class="btn-cancel">
                    <i class="fas fa-times"></i>
                    Cancel
                </a>
                <button form="createAuditSiteForm" type="submit" class="btn-submit">
                    <i class="fas fa-plus"></i>
                    Create Audit Site
                </button>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="form-sidebar">
            <div class="form-sidebar-card">
                <h3>
                    <i class="fas fa-info-circle"></i>
                    About Audit Sites
                </h3>
                <p>
                    Audit sites are the specific places within an airport where audits are conducted. Each site belongs to one airport and one department.
                </p>
            </div>

            <div class="form-sidebar-card">
                <h3>
                    <i class="fas fa-sitemap"></i>
                    Site Types
                </h3>
                <ul style="list-style: none; padding: 0; margin: 0; font-size: 12px;">
                    <li style="margin-bottom: 8px;">
                        <strong>Operations</strong> — Terminal, Airside or Landside. Site types come from the airport's own locations.
                    </li>
                    <li>
                        <strong>Commercial</strong> — Food &amp; Beverage, Retail, Bank, Services or Car Rental. The matching ACSA checklist is linked automatically.
                    </li>
                </ul>
            </div>

            <div class="form-sidebar-card form-sidebar-help">
                <h3>
                    <i class="fas fa-question-circle"></i>
                    Missing a location?
                </h3>
                <p>
                    Terminals and Terminal, Airside and Landside locations are managed on the airport. Add them there and they'll appear here.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/audit-site-form.js" asp-append-version="true"></script>
}
