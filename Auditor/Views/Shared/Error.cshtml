@model ErrorViewModel
@{
    var code = ViewBag.StatusCode as int?;
    var notFound = code == 404;
    ViewData["Title"] = notFound ? "Page Not Found" : "Something Went Wrong";
}

<div class="list-container">
    <div class="list-table-wrapper">
        <div class="list-empty-state">
            <div class="empty-state-icon">@(notFound ? "🧭" : "⚠️")</div>
            <h2 class="empty-state-title">@(notFound ? "We couldn't find that page" : "Something went wrong")</h2>
            <p class="empty-state-text">
                @if (notFound)
                {
                    <span>The link may be out of date, or the record was removed.</span>
                }
                else
                {
                    <span>The request couldn't be completed. Try again, and contact support if it keeps happening.</span>
                }
            </p>
            @if (Model.ShowRequestId && !notFound)
            {
                <p class="empty-state-text"><small>Reference: <code>@Model.RequestId</code></small></p>
            }
            <a asp-controller="Dashboard" asp-action="Index" class="btn-list-primary">Back to Dashboard</a>
        </div>
    </div>
</div>
